# Copy this file to ".env" for local use (npm start). On Netlify, set the same
# names under Site configuration > Environment variables instead.
# Keep real keys ONLY here or in Netlify. Never put them in index.html or on GitHub.

PORT=3000
HOST=127.0.0.1

# Server-side API keys (set at least one). Visitors then need no key of their own.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional
DEFAULT_PROVIDER=gemini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ALLOWED_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# MAX_TOKENS=3000
